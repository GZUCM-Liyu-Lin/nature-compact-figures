font.family: Arial
font.size: 7
axes.titlesize: 7
axes.titleweight: bold
axes.labelsize: 7
xtick.labelsize: 7
ytick.labelsize: 7
legend.fontsize: 6
legend.title_fontsize: 6
axes.linewidth: 0.6
axes.spines.top: False
axes.spines.right: False
axes.grid: False
axes.labelpad: 2
axes.titlepad: 3
xtick.major.size: 2
ytick.major.size: 2
xtick.major.width: 0.5
ytick.major.width: 0.5
xtick.major.pad: 2
ytick.major.pad: 2
lines.linewidth: 0.8
legend.frameon: False
legend.borderpad: 0.2
legend.labelspacing: 0.3
legend.handlelength: 1.2
legend.handletextpad: 0.5
legend.borderaxespad: 0.3
legend.columnspacing: 0.8
figure.facecolor: white
axes.facecolor: white
savefig.facecolor: white
savefig.dpi: 600
pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: none
axes.prop_cycle: cycler('color', ['FD6964', '80C0A5', '85A2BA', 'A0C95D', 'E61771', 'BF88B0', 'BBAAC9', '6975A8', 'EFCB81', 'FCC0C3'])
